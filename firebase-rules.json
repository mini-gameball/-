{
  "rules": {
    ".read": false,
    ".write": false,

    "names": {
      "$name": {
        ".read": "auth != null",
        ".write": "auth != null && $name.length <= 32 && (!data.exists() || data.child('uid').val() === auth.uid || (data.child('key').exists() && !data.child('g').exists() && !root.child('nameKeys').child($name).exists() && newData.child('key').exists() && data.child('key').val() === newData.child('key').val()) || (!data.child('g').exists() && root.child('nameKeys').child($name).child('k').isString() && root.child('nameClaims').child($name).child(auth.uid).isString() && root.child('nameClaims').child($name).child(auth.uid).val() === root.child('nameKeys').child($name).child('k').val()) || (data.child('uid').isString() && root.child('users').child(data.child('uid').val()).child('lastSeen').isNumber() && root.child('users').child(data.child('uid').val()).child('lastSeen').val() < now - 2592000000 && (!root.child('wallet').child(data.child('uid').val()).child('coins').isNumber() || root.child('wallet').child(data.child('uid').val()).child('coins').val() <= 0)))",
        ".validate": "newData.hasChildren(['uid','name']) && newData.child('uid').val() === auth.uid",
        "uid": { ".validate": "newData.isString()" },
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && !newData.val().contains('<') && !newData.val().contains('>') && newData.val().toLowerCase() === $name" },
        "key": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "g": { ".validate": "newData.val() === true && (auth.token.email_verified === true || auth.token.firebase.sign_in_provider === 'google.com' || auth.token.firebase.sign_in_provider === 'facebook.com' || auth.token.firebase.sign_in_provider === 'password')" },
        "$other": { ".validate": false }
      }
    },

    "nameKeys": {
      "$name": {
        ".read": false,
        ".write": "auth != null && $name.length <= 32 && root.child('names').child($name).child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['k'])",
        "k": { ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 64" },
        "$other": { ".validate": false }
      }
    },

    "nameClaims": {
      "$name": {
        "$uid": {
          ".read": false,
          ".write": "auth != null && auth.uid === $uid && $name.length <= 32",
          ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 64"
        }
      }
    },

    "users": {
      ".read": "auth != null && query.orderByChild === 'nameLower' && query.limitToFirst <= 12",
      ".indexOn": ["nameLower", "lastSeen"],
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && !newData.val().contains('<') && !newData.val().contains('>') && (newData.val() === data.val() || root.child('names').child(newData.val().toLowerCase()).child('uid').val() === auth.uid)" },
        "nameLower": { ".validate": "newData.isString() && newData.val().length <= 32 && newData.val() === newData.parent().child('name').val().toLowerCase()" },
        "status": { ".validate": "newData.isString() && newData.val().matches(/^(online|ingame|offline)$/)" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "roomId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "fcmToken": { ".validate": "newData.isString() && newData.val().length <= 512" },
        "$other": { ".validate": false }
      }
    },

    "invites": {
      "$toUid": {
        ".read": "auth != null && auth.uid === $toUid",
        ".indexOn": ["status"],
        "$id": {
          ".write": "auth != null && (auth.uid === $toUid || (!data.exists() && newData.child('fromUid').val() === auth.uid))",
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,64}$/) && newData.hasChildren(['fromUid','fromName','roomId','status'])",
          "fromUid": { ".validate": "newData.isString() && (data.exists() ? newData.val() === data.val() : newData.val() === auth.uid)" },
          "fromName": { ".validate": "newData.isString() && newData.val().length <= 16 && (data.exists() ? newData.val() === data.val() : newData.val() === root.child('users').child(auth.uid).child('name').val())" },
          "roomId": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,64}$/) && (data.exists() ? newData.val() === data.val() : (root.child('rooms').child(newData.val()).child('host').val() === auth.uid && root.child('rooms').child(newData.val()).child('members').child($toUid).exists()))" },
          "kind": { ".validate": "newData.isString() && newData.val().matches(/^(single|group)$/)" },
          "createdAt": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() <= now)" },
          "status": { ".validate": "newData.isString() && (data.exists() ? newData.val().matches(/^(pending|accepted|declined)$/) : newData.val() === 'pending')" },
          "$other": { ".validate": false }
        }
      }
    },

    "pts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['p','w','l','g','b','t']) && newData.child('t').val() === now && newData.child('w').val() + newData.child('l').val() === newData.child('g').val() && newData.child('b').val() >= newData.child('p').val() && newData.child('b').val() <= newData.child('g').val() * 5000 && (data.exists() ? (newData.child('g').val() > data.child('g').val() && (newData.child('g').val() - data.child('g').val()) <= 200 && now - data.child('t').val() >= 25000 * (newData.child('g').val() - data.child('g').val()) && newData.child('p').val() - data.child('p').val() <= 4400 * (newData.child('g').val() - data.child('g').val()) && newData.child('b').val() >= data.child('b').val()) : (newData.child('g').val() <= 5000 && newData.child('p').val() <= 4400 * newData.child('g').val()))",
        "p": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "w": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "l": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "g": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "b": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "t": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "rooms": {
      "$rid": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid && newData.child('members').child(auth.uid).exists()) || (!newData.exists() && data.child('host').val() === auth.uid))",
        ".validate": "$rid.matches(/^[A-Za-z0-9_-]{1,64}$/) && newData.hasChildren(['host','status','members'])",
        "host": { ".validate": "newData.isString()" },
        "kind": { ".validate": "newData.isString() && newData.val().matches(/^(single|group)$/)" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "status": {
          ".write": "auth != null && root.child('rooms').child($rid).child('host').val() === auth.uid",
          ".validate": "newData.isString() && (data.exists() ? newData.val().matches(/^(waiting|playing)$/) : newData.val() === 'waiting')"
        },
        "startAt": {
          ".write": "auth != null && root.child('rooms').child($rid).child('host').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "config": {
          ".validate": "newData.hasChildren(['stage'])",
          "stage": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9" },
          "theme": { ".validate": "newData.isNumber() || (newData.isString() && newData.val().length <= 16)" },
          "dist": { ".validate": "newData.isString() && newData.val().matches(/^(near|mid|far)$/)" },
          "tod": { ".validate": "newData.isString() && newData.val().matches(/^(day|night)$/)" },
          "maxPlayers": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 6" },
          "$other": { ".validate": false }
        },

        "members": {
          "$uid": {
            ".write": "auth != null && (root.child('rooms').child($rid).child('host').val() === auth.uid || (auth.uid === $uid && data.exists()))",
            ".validate": "newData.hasChildren(['name'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && !newData.val().contains('<') && !newData.val().contains('>')" },
            "joined": { ".validate": "newData.isBoolean()" },
            "present": { ".validate": "newData.isBoolean()" },
            "host": { ".validate": "newData.isBoolean()" },
            "stk": {
              ".validate": "newData.hasChildren(['k','i','ts'])",
              "k": { ".validate": "newData.isString() && newData.val().matches(/^(win|lose|cheer|tease)$/)" },
              "i": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 63" },
              "ts": { ".validate": "newData.val() === now && (!data.exists() || now - data.val() >= 3000)" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },

        "shots": {
          "$sid": {
            ".write": "auth != null && !data.exists() && root.child('rooms').child($rid).child('status').val() === 'playing' && root.child('rooms').child($rid).child('members').child(auth.uid).child('joined').val() === true",
            ".validate": "$sid.matches(/^[A-Za-z0-9_-]{1,64}$/) && newData.hasChildren(['by','pi','dx','dz','power']) && newData.child('by').val() === auth.uid",
            "by": { ".validate": "newData.isString()" },
            "pi": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
            "dx": { ".validate": "newData.isNumber() && newData.val() >= -1.001 && newData.val() <= 1.001" },
            "dz": { ".validate": "newData.isNumber() && newData.val() >= -1.001 && newData.val() <= 1.001" },
            "power": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 22.001" },
            "ts": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "post": {
          "$seq": {
            ".write": "auth != null && root.child('rooms').child($rid).child('status').val() === 'playing' && root.child('rooms').child($rid).child('members').child(auth.uid).child('joined').val() === true",
            ".validate": "$seq.matches(/^[0-9]{1,4}$/) && newData.hasChildren(['phase'])",
            "by": { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "marbles": {
              ".validate": "newData.hasChildren()",
              "$i": {
                ".validate": "$i.matches(/^[0-9]$/) && newData.hasChildren(['p','x','z'])",
                "p": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
                "x": { ".validate": "newData.isNumber() && newData.val() >= -30 && newData.val() <= 30" },
                "z": { ".validate": "newData.isNumber() && newData.val() >= -30 && newData.val() <= 30" },
                "holed": { ".validate": "newData.isBoolean()" },
                "$other": { ".validate": false }
              }
            },
            "order": {
              ".validate": "newData.hasChildren()",
              "$i": { ".validate": "$i.matches(/^[0-9]$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" }
            },
            "phase": { ".validate": "newData.isString() && newData.val().matches(/^(toss|play)$/)" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
